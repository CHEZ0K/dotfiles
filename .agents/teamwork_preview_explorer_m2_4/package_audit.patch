diff -u -N -r a/tests/vm_acceptance_check.sh b/tests/vm_acceptance_check.sh
--- a/tests/vm_acceptance_check.sh	2026-10-10 11:21:31.901560476 +0300
+++ b/tests/vm_acceptance_check.sh	2026-10-10 11:22:05.905818835 +0300
@@ -157,6 +157,71 @@
 fi
 
 # -----------------------------------------------------------------------------
+# Check 15: Vibepanel Desktop Bar/Panel Installed (R1)
+# -----------------------------------------------------------------------------
+if pacman -Q vibepanel-bin &>/dev/null || pacman -Q vibepanel-git &>/dev/null || pacman -Q vibepanel &>/dev/null || which vibepanel &>/dev/null; then
+    vibe_ver=$(pacman -Q vibepanel-bin 2>/dev/null || pacman -Q vibepanel-git 2>/dev/null || which vibepanel 2>/dev/null || echo "installed")
+    report_check "PKG_VIBEPANEL" "PASS" "Vibepanel installed: ${vibe_ver}"
+else
+    report_check "PKG_VIBEPANEL" "FAIL" "Vibepanel is not installed"
+fi
+
+# -----------------------------------------------------------------------------
+# Check 16: Zen Browser Installed (R1)
+# -----------------------------------------------------------------------------
+if pacman -Q zen-browser-bin &>/dev/null || pacman -Q zen-browser &>/dev/null; then
+    zen_ver=$(pacman -Q zen-browser-bin 2>/dev/null || pacman -Q zen-browser 2>/dev/null)
+    report_check "PKG_ZEN_BROWSER" "PASS" "Zen browser installed: ${zen_ver}"
+else
+    report_check "PKG_ZEN_BROWSER" "FAIL" "Zen browser is not installed"
+fi
+
+# -----------------------------------------------------------------------------
+# Check 17: AyuGram Telegram Desktop Installed (R1)
+# -----------------------------------------------------------------------------
+if pacman -Q ayugram-desktop &>/dev/null || pacman -Q ayugram-desktop-bin &>/dev/null; then
+    ayu_ver=$(pacman -Q ayugram-desktop 2>/dev/null || pacman -Q ayugram-desktop-bin 2>/dev/null)
+    report_check "PKG_AYUGRAM_DESKTOP" "PASS" "AyuGram desktop installed: ${ayu_ver}"
+else
+    report_check "PKG_AYUGRAM_DESKTOP" "FAIL" "AyuGram desktop is not installed"
+fi
+
+# -----------------------------------------------------------------------------
+# Check 18: Core Wayland Compositors & Display Environment Installed (R1)
+# -----------------------------------------------------------------------------
+missing_env=()
+for p in niri hyprland waybar sddm; do
+    pacman -Q "$p" &>/dev/null || missing_env+=("$p")
+done
+if [[ ${#missing_env[@]} -eq 0 ]]; then
+    report_check "PKG_WAYLAND_ENV" "PASS" "All desktop environment packages installed (niri, hyprland, waybar, sddm)"
+else
+    report_check "PKG_WAYLAND_ENV" "FAIL" "Missing desktop environment packages: ${missing_env[*]}"
+fi
+
+# -----------------------------------------------------------------------------
+# Check 19: Core CLI Monitoring & Fetch Utilities Installed (R1)
+# -----------------------------------------------------------------------------
+missing_cli=()
+for p in btop htop fastfetch; do
+    pacman -Q "$p" &>/dev/null || missing_cli+=("$p")
+done
+if [[ ${#missing_cli[@]} -eq 0 ]]; then
+    report_check "PKG_CLI_UTILS" "PASS" "CLI utilities installed (btop, htop, fastfetch)"
+else
+    report_check "PKG_CLI_UTILS" "FAIL" "Missing CLI utilities: ${missing_cli[*]}"
+fi
+
+# -----------------------------------------------------------------------------
+# Check 20: Graphics Stack & Drivers Installed (R1)
+# -----------------------------------------------------------------------------
+if pacman -Q mesa &>/dev/null && (pacman -Q vulkan-intel &>/dev/null || pacman -Q vulkan-radeon &>/dev/null || pacman -Q vulkan-icd-loader &>/dev/null); then
+    report_check "PKG_GRAPHICS_STACK" "PASS" "Mesa and Vulkan driver stack installed"
+else
+    report_check "PKG_GRAPHICS_STACK" "FAIL" "Mesa / Vulkan driver stack is missing"
+fi
+
+# -----------------------------------------------------------------------------
 # Summary and Final Verdict
 # -----------------------------------------------------------------------------
 echo ""
