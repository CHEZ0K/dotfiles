--- a/tests/vm_acceptance_check.sh
+++ b/tests/vm_acceptance_check.sh
@@ -157,6 +157,70 @@
 fi
 
 # -----------------------------------------------------------------------------
+# Check 15: Vibepanel Installed (R1 Acceptance Criteria)
+# -----------------------------------------------------------------------------
+if pacman -Q vibepanel-bin &>/dev/null; then
+    report_check "PKG_VIBEPANEL" "PASS" "Vibepanel installed: $(pacman -Q vibepanel-bin)"
+elif pacman -Q vibepanel-git &>/dev/null; then
+    report_check "PKG_VIBEPANEL" "PASS" "Vibepanel installed: $(pacman -Q vibepanel-git)"
+elif pacman -Q vibepanel &>/dev/null; then
+    report_check "PKG_VIBEPANEL" "PASS" "Vibepanel installed: $(pacman -Q vibepanel)"
+else
+    report_check "PKG_VIBEPANEL" "FAIL" "vibepanel is not installed"
+fi
+
+# -----------------------------------------------------------------------------
+# Check 16: Zen Browser Installed (R1 Acceptance Criteria)
+# -----------------------------------------------------------------------------
+if pacman -Q zen-browser-bin &>/dev/null; then
+    report_check "PKG_ZEN_BROWSER" "PASS" "Zen browser installed: $(pacman -Q zen-browser-bin)"
+else
+    report_check "PKG_ZEN_BROWSER" "FAIL" "zen-browser-bin is not installed"
+fi
+
+# -----------------------------------------------------------------------------
+# Check 17: AyuGram Desktop Installed (R1 Acceptance Criteria)
+# -----------------------------------------------------------------------------
+if pacman -Q ayugram-desktop &>/dev/null; then
+    report_check "PKG_AYUGRAM_DESKTOP" "PASS" "AyuGram desktop installed: $(pacman -Q ayugram-desktop)"
+elif pacman -Q ayugram-desktop-bin &>/dev/null; then
+    report_check "PKG_AYUGRAM_DESKTOP" "PASS" "AyuGram desktop installed: $(pacman -Q ayugram-desktop-bin)"
+else
+    report_check "PKG_AYUGRAM_DESKTOP" "FAIL" "ayugram-desktop is not installed"
+fi
+
+# -----------------------------------------------------------------------------
+# Check 18: Wayland Environment Installed (niri, hyprland, waybar, sddm)
+# -----------------------------------------------------------------------------
+wayland_missing=()
+for wp in niri hyprland waybar sddm; do
+    pacman -Q "$wp" &>/dev/null || wayland_missing+=("$wp")
+done
+if [[ ${#wayland_missing[@]} -eq 0 ]]; then
+    report_check "PKG_WAYLAND_STACK" "PASS" "Wayland stack packages installed (niri, hyprland, waybar, sddm)"
+else
+    report_check "PKG_WAYLAND_STACK" "FAIL" "Missing Wayland packages: ${wayland_missing[*]}"
+fi
+
+# -----------------------------------------------------------------------------
+# Check 19: Terminals and CLI Utilities Installed (foot/kitty, btop)
+# -----------------------------------------------------------------------------
+if (pacman -Q foot &>/dev/null || pacman -Q kitty &>/dev/null) && pacman -Q btop &>/dev/null; then
+    report_check "PKG_TERMINALS_AND_CLI" "PASS" "Terminal and btop utility installed"
+else
+    report_check "PKG_TERMINALS_AND_CLI" "FAIL" "foot/kitty or btop is not installed"
+fi
+
+# -----------------------------------------------------------------------------
+# Check 20: Intel / Mesa Graphics Driver Stack Installed
+# -----------------------------------------------------------------------------
+if pacman -Q mesa &>/dev/null && pacman -Q vulkan-intel &>/dev/null; then
+    report_check "PKG_GRAPHICS_INTEL" "PASS" "Mesa and Vulkan Intel drivers installed"
+else
+    report_check "PKG_GRAPHICS_INTEL" "FAIL" "mesa or vulkan-intel driver is missing"
+fi
+
+# -----------------------------------------------------------------------------
 # Summary and Final Verdict
 # -----------------------------------------------------------------------------
 echo ""
