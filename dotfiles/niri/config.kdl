// ===================================================
// NIRI CONFIGURATION (Migrated from Hyprland)
// ===================================================

// ==================== ВВОД (INPUT) ====================
input {
    keyboard {
        xkb {
            layout "us,ru"
            model "pc105"
            options "grp:alt_shift_toggle"
        }
        track-layout "window"
        repeat-delay 600
        repeat-rate 25
    }

    touchpad {
        tap
    }

    // Окно становится активным при наведении мыши, но лента/экран НИКОГДА не сдвигается
    focus-follows-mouse max-scroll-amount="0%"
}

// ==================== МОНИТОР (OUTPUT) ====================
output "eDP-1" {
    mode "1920x1080@60.003"
    scale 1.5
    backdrop-color "#04050F"
    variable-refresh-rate on-demand=true

    hot-corners {
        top-left
    }
}

// ==================== ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ====================
environment {
    XCURSOR_THEME "Furina"
    XCURSOR_SIZE "32"
    HYPRCURSOR_SIZE "32"
    QT_QPA_PLATFORM "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    MOZ_ENABLE_WAYLAND "1"
    LIBVA_DRIVER_NAME "radeonsi"
    VDPAU_DRIVER "radeonsi"
    AMD_VULKAN_ICD "RADV"
    RADV_PERFTEST "aco"
    mesa_glthread "true"
    MESA_SHADER_CACHE_MAX_SIZE "2G"
    NO_AT_BRIDGE "1"
    QT_ACCESSIBILITY "0"
}

// ==================== КУРСОР (CURSOR) ====================
cursor {
    xcursor-theme "Furina"
    xcursor-size 32
    hide-after-inactive-ms 3000
}

// ==================== РАЗМЫТИЕ (BLUR) ====================
blur {
    passes 1
    offset 1.0
    noise 0.01
    saturation 1.1
}

// ==================== РАЗМЕТКА И ГЕОМЕТРИЯ (LAYOUT) ====================
layout {
    gaps 10
    center-focused-column "on-overflow"
    default-column-display "normal"

    focus-ring {
        off
    }

    border {
        off
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    shadow {
        on
        softness 25
        spread 4
        offset x=0 y=4
        color "#000000aa"
        draw-behind-window false
    }

    tab-indicator {
        off
    }

    insert-hint {
        off
    }

    struts {
        bottom -4
    }
}

// ==================== АНИМАЦИИ (ANIMATIONS) ====================
animations {
    slowdown 0.8

    horizontal-view-movement {
        spring damping-ratio=0.78 stiffness=480 epsilon=0.0001
    }

    window-open {
        spring damping-ratio=0.75 stiffness=600 epsilon=0.001
    }

    window-close {
        duration-ms 200
        curve "ease-out-quad"
    }

    window-movement {
        duration-ms 250
        curve "ease-out-expo"
    }

    window-resize {
        spring damping-ratio=0.75 stiffness=600 epsilon=0.0001
    }

    workspace-switch {
        spring damping-ratio=0.78 stiffness=780 epsilon=0.0001
    }

    overview-open-close {
        duration-ms 250
        curve "ease-out-expo"
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    config-notification-open-close {
        spring damping-ratio=0.75 stiffness=1000 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=0.75 stiffness=700 epsilon=0.01
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }
}

// ==================== АВТОЗАПУСК (AUTOSTART) ====================
// spawn-at-startup "waybar"
spawn-at-startup "/home/chezok/.local/bin/vibepanel"
spawn-at-startup "/home/chezok/.config/niri/scripts/restore-wallpaper.sh"
// spawn-at-startup "cava-daemon"
// spawn-at-startup "/home/chezok/.local/bin/custom-sidebar" "--daemon"
spawn-at-startup "/home/chezok/.config/niri/scripts/wallpaper-color-watcher.sh"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "udiskie" "--smart-tray"
// Отключаем клиентские заголовки/декорации (titlebars) у всех окон
prefer-no-csd

// Подсказка горячих клавиш (не показывать автоматически при старте)
hotkey-overlay {
    skip-at-startup
}

// Путь для сохранения скриншотов
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// XWayland Satellite: используем стабильную версию 0.8.1 без бага с выпадающими меню Steam
xwayland-satellite {
    path "/home/chezok/.local/bin/xwayland-satellite"
}

// ==================== ПРАВИЛА ДЛЯ ОКОН (WINDOW RULES) ====================
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    draw-border-with-background false
}

// Размытие фона для терминала Foot
window-rule {
    match app-id=r#"^foot.*"#
    background-effect {
        blur true
    }
}

// Размытие фона для Zen Browser
window-rule {
    match app-id="zen"
    background-effect {
        blur true
    }
}

// Размытие фона и прозрачность для файлового менеджера Nemo
window-rule {
    match app-id="nemo"
    background-effect {
        blur true
    }
    opacity 0.88
}


// Размытие фона для боковой шторки (custom-sidebar)
layer-rule {
    match namespace="custom-sidebar"
    background-effect {
        blur true
    }
}

// Cava под баром: плавающее окно строго под Waybar, на всю ширину, без подсветки
window-rule {
    match app-id="cavaunderbar"
    open-floating true
    open-focused false
    default-floating-position x=0 y=-29 relative-to="top-left"
    min-width 1280
    max-width 1280
    min-height 40
    max-height 40
    opacity 0.5
    focus-ring { off; }
    border { off; }
    shadow { off; }
    draw-border-with-background false
}


// Firefox / Zen Picture-in-Picture
window-rule {
    match app-id=r#"(firefox|zen)"# title="^Picture-in-Picture$"
    open-floating true
}

// Защита приватности AyuGram (черный экран на скриншотах и стримах)
window-rule {
    match app-id=r#"^(com\.ayugram\.desktop|AyuGram|ayugram)$"#
    block-out-from "screen-capture"
}

// Steam: все вспомогательные окна (настройки, друзья, чаты, диалоги) открывать плавающими
window-rule {
    match app-id="steam"
    open-floating true
    default-floating-position x=215 y=10 relative-to="top-left"
}

// Главное окно Steam оставляем тайловым
window-rule {
    match app-id="steam" title="^Steam$"
    open-floating false
}

// Всплывающие уведомления Steam в нижнем правом углу
window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=20 y=20 relative-to="bottom-right"
    open-focused false
}

// Игры Steam и Proton открывать в полноэкранном режиме
window-rule {
    match app-id=r#"^steam_app_.*"#
    open-fullscreen true
}

window-rule {
    match app-id=r#"^steam_proton.*"#
    open-fullscreen true
}

window-rule {
    match title=r#"^RESIDENT EVIL 2.*"#
    open-fullscreen true
}


// ==================== ХОТКЕИ (KEYBINDINGS) ====================
binds {
    // Основные программы (как в Hyprland)
    Mod+Q { spawn "footclient"; }
    Mod+C { close-window; }
    Mod+E { spawn "nemo"; }
    Mod+R { spawn "rofi" "-show" "drun"; }
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { spawn-sh "~/.config/niri/scripts/clipboard.sh"; }
    Mod+Alt+V { switch-focus-between-floating-and-tiling; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    // Выход из сессии
    Mod+Shift+E { quit; }
    Mod+M { quit; }

    // Кастомные скрипты
    Mod+A { spawn-sh "~/.local/bin/cava_manager.sh toggle"; }
    Mod+N { spawn-sh "~/.config/niri/scripts/control_center.sh"; }
    Mod+W { spawn-sh "~/.config/niri/scripts/wallpaper-selector.sh"; }

    // Обзор рабочих столов (Overview)
    Mod+O { toggle-overview; }

    // Навигация по ленте окон (Стрелки и Vim)
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // Перемещение окон в ленте
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+J     { move-window-down; }

    // Управление шириной и объединение окон в колонку (стек)
    Mod+X            { consume-or-expel-window-left; }
    Mod+Shift+X      { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }

    Mod+Minus        { set-column-width "-10%"; }
    Mod+Equal        { set-column-width "+10%"; }
    Mod+Shift+Minus  { set-window-height "-10%"; }
    Mod+Shift+Equal  { set-window-height "+10%"; }

    Mod+Shift+R      { switch-preset-column-width; }
    Mod+Ctrl+R       { reset-window-height; }
    Mod+Ctrl+C       { center-column; }

    // Воркспейсы 1-9
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Tab     { focus-workspace-previous; }

    // Прокрутка колесиком мыши (с зажатым Mod)
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight     { focus-column-right; }
    Mod+WheelScrollLeft      { focus-column-left; }

    // Скриншоты (встроенный в Niri интерактивный инструмент)
    Print       { screenshot; }
    Mod+Shift+S { screenshot; }
    Ctrl+Print  { screenshot-screen; }
    Alt+Print   { screenshot-window; }

    // Мультимедиа и яркость (с сохранением работы на локскрине)
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%-"; }

    XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPause        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }
}

// ==================== СОБЫТИЯ ПЕРЕКЛЮЧАТЕЛЕЙ (SWITCH EVENTS) ====================
switch-events {
    lid-close { spawn "systemctl" "suspend"; }
}

