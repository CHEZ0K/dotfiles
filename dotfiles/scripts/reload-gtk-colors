#!/usr/bin/env python3
import os
import sys
import json
import subprocess
import time

WAL_JSON = os.path.expanduser("~/.cache/wal/colors.json")
GTK3_CSS = os.path.expanduser("~/.config/gtk-3.0/gtk.css")

def update_gtk_css():
    if not os.path.exists(WAL_JSON):
        return
    with open(WAL_JSON, "r") as f:
        data = json.load(f)

    bg = data.get("special", {}).get("background", "#0C0418")
    fg = data.get("special", {}).get("foreground", "#abbdd9")
    colors = data.get("colors", {})
    c1 = colors.get("color1", "#453762")
    c2 = colors.get("color2", "#334477")
    c4 = colors.get("color4", "#2D5392")
    c5 = colors.get("color5", "#375EA8")

    css = f"""/* Auto-generated dynamic GTK3 CSS by pywal */
@define-color theme_bg_color {bg};
@define-color theme_fg_color {fg};
@define-color theme_base_color {bg};
@define-color theme_text_color {fg};
@define-color theme_selected_bg_color {c4};
@define-color theme_selected_fg_color #ffffff;

@define-color accent_color {c4};
@define-color accent_bg_color {c4};
@define-color accent_fg_color #ffffff;
@define-color window_bg_color {bg};
@define-color window_fg_color {fg};
@define-color headerbar_bg_color shade({bg}, 1.25);
@define-color headerbar_fg_color {fg};
@define-color sidebar_bg_color shade({bg}, 1.15);
@define-color sidebar_fg_color {fg};
@define-color view_bg_color {bg};
@define-color view_fg_color {fg};

/* ==================== NEMO DYNAMIC GLASS STYLING ==================== */

.nemo-window,
.nemo-window.background,
NemoWindow,
NemoWindow.background {{
    background-color: alpha({bg}, 0.85);
    color: {fg};
}}

/* Top MenuBar */
.nemo-window menubar,
.nemo-window .menubar {{
    background: alpha(shade({bg}, 1.15), 0.85);
    border-bottom: 1px solid alpha(#ffffff, 0.05);
    color: {fg};
    padding: 2px 4px;
}}

.nemo-window menubar > menuitem,
.nemo-window .menubar > menuitem {{
    color: {fg};
    padding: 3px 8px;
    border-radius: 4px;
}}

.nemo-window menubar > menuitem:hover,
.nemo-window .menubar > menuitem:hover {{
    background: alpha({c4}, 0.35);
    color: #ffffff;
}}

.nemo-window toolbar,
.nemo-window .toolbar,
.nemo-window .primary-toolbar {{
    background: alpha(shade({bg}, 1.25), 0.75);
    border-bottom: 1px solid alpha(#ffffff, 0.08);
    color: {fg};
    padding: 4px 6px;
}}

.nemo-window toolbar button,
.nemo-window .primary-toolbar button {{
    background: transparent;
    color: {fg};
    border: none;
    border-radius: 6px;
    padding: 4px 6px;
    margin: 1px;
}}

.nemo-window toolbar button:hover,
.nemo-window .primary-toolbar button:hover {{
    background: alpha(#ffffff, 0.12);
    color: #ffffff;
}}

.nemo-window toolbar button:checked,
.nemo-window toolbar button:active {{
    background: alpha({c4}, 0.55);
    color: #ffffff;
}}

/* Text entry for path bar (plain textual location entry) */
.nemo-window .primary-toolbar entry,
.nemo-window toolbar entry,
.nemo-window .location-bar entry {{
    background-color: alpha(shade({bg}, 1.1), 0.7);
    border: 1px solid alpha(#ffffff, 0.12);
    border-radius: 6px;
    color: {fg};
    padding: 4px 10px;
    font-size: 12px;
}}

.nemo-window .primary-toolbar entry:focus,
.nemo-window toolbar entry:focus,
.nemo-window .location-bar entry:focus {{
    background-color: alpha(shade({bg}, 1.2), 0.85);
    border-color: alpha({c4}, 0.8);
    color: #ffffff;
}}

menu,
.menu {{
    background-color: alpha(shade({bg}, 1.2), 0.95);
    border: 1px solid alpha(#ffffff, 0.12);
    border-radius: 8px;
    padding: 4px;
    color: {fg};
}}

menu menuitem,
.menu menuitem {{
    border-radius: 6px;
    padding: 4px 8px;
    color: {fg};
}}

menu menuitem:hover,
.menu menuitem:hover {{
    background-color: alpha({c4}, 0.5);
    color: #ffffff;
}}

.nemo-window .sidebar,
.nemo-window .sidebar .view,
.nemo-window .sidebar iconview,
.nemo-window .sidebar treeview,
.nemo-window .sidebar row,
.nemo-window .places-treeview,
.nemo-window .places-treeview .view,
.nemo-window .places-treeview iconview,
.nemo-window .nemo-places-sidebar,
.nemo-places-sidebar {{
    background-color: alpha(shade({bg}, 1.15), 0.75);
    border-right: 1px solid alpha(#ffffff, 0.08);
    color: {fg};
}}

.nemo-places-sidebar row,
.nemo-window .sidebar row {{
    border-radius: 6px;
    margin: 1px 4px;
    padding: 4px 6px;
    color: {fg};
}}

.nemo-places-sidebar row:hover,
.nemo-window .sidebar row:hover {{
    background-color: alpha(#ffffff, 0.08);
    color: #ffffff;
}}

.nemo-places-sidebar row:selected,
.nemo-window .sidebar row:selected {{
    background-color: alpha({c4}, 0.5);
    color: #ffffff;
}}

.nemo-window .nemo-window-pane,
.nemo-window .nemo-inactive-pane,
.nemo-window .nemo-inactive-pane .view,
.nemo-window .view,
.nemo-window iconview,
.nemo-window treeview,
.nemo-window .content-view,
.nemo-window NemoView,
.nemo-window NemoIconView,
.nemo-window NemoListView,
NemoView,
.nemo-view {{
    background-color: alpha({bg}, 0.8);
    color: {fg};
}}

.nemo-window .view:selected,
.nemo-window iconview:selected,
.nemo-window treeview:selected,
.nemo-window NemoView:selected,
.nemo-view:selected {{
    background-color: alpha({c4}, 0.45);
    color: #ffffff;
    border-radius: 8px;
}}

/* Sidebar Info Panel (Bottom Left Details Card) */
.nemo-sidebar-info-panel {{
    background-color: alpha(shade({bg}, 1.25), 0.65);
    border: 1px solid alpha(#ffffff, 0.08);
    border-radius: 8px;
    margin: 6px;
    padding: 8px 10px;
}}

.nemo-sidebar-info-panel label {{
    color: {fg};
    font-size: 11px;
}}

.nemo-sidebar-info-panel .dim-label {{
    color: alpha({fg}, 0.7);
    font-size: 10px;
}}

.nemo-sidebar-info-panel separator {{
    background-color: alpha(#ffffff, 0.08);
    min-height: 1px;
    margin: 4px 0;
}}

.nemo-window statusbar,
.nemo-statusbar {{
    background: alpha(shade({bg}, 1.15), 0.85);
    border-top: 1px solid alpha(#ffffff, 0.06);
    color: alpha({fg}, 0.75);
    padding: 2px 8px;
}}

.nemo-statusbar label {{
    color: {fg};
    font-size: 11px;
}}

.nemo-window scrollbar trough {{
    background: transparent;
    border: none;
}}

.nemo-window scrollbar slider {{
    background: alpha({c4}, 0.45);
    border-radius: 4px;
    min-width: 4px;
    min-height: 4px;
}}

.nemo-window scrollbar slider:hover {{
    background: alpha({c5}, 0.85);
}}
"""
    with open(GTK3_CSS, "w", encoding="utf-8") as f:
        f.write(css)

def main():
    # 1. Update gtk.css directly so GTK GFileMonitor detects the change instantly
    update_gtk_css()

    # 2. Update folder icon SVGs
    sync_script = os.path.expanduser("~/.local/bin/sync-icon-colors")
    if os.path.exists(sync_script):
        subprocess.run([sync_script, "--force"], check=False)

    # 3. Trigger Cinnamon and GNOME theme & icon reload in running applications
    current_icons = "Tela-circle-wal"
    cmd = f"""
    gsettings set org.cinnamon.desktop.interface icon-theme "Mint-Y-Dark"
    gsettings set org.cinnamon.desktop.interface icon-theme "{current_icons}"
    gsettings set org.gnome.desktop.interface icon-theme "Mint-Y-Dark"
    gsettings set org.gnome.desktop.interface icon-theme "{current_icons}"
    """
    subprocess.run(cmd, shell=True, check=False)

if __name__ == "__main__":
    main()
